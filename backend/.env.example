# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Public site base URL (used to build QR verification links)
PUBLIC_URL=http://localhost:5173

# Supabase (service role key is SERVER-SIDE ONLY — never expose to the browser)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Bootstrap admin (used only by `npm run seed`)
SEED_ADMIN_EMAIL=admin@gangstersclub.com
SEED_ADMIN_PASSWORD=CHANGE-ME
